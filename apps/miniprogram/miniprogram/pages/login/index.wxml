<view class="account">
  <view class="mark">狸</view><view class="eyebrow">令狸 · 你的故事伙伴</view>
  <view class="title">给你的故事，留一个位置</view><view class="intro">登录后，你的聊天、资料和文稿会保存在自己的账号里。</view>
  <block wx:if="{{accountPhone}}"><view class="label">已登录 {{accountPhone}}</view><button class="primary" bindtap="home">回到令狸身边</button><button bindtap="logout" disabled="{{busy}}">退出登录</button></block>
  <block wx:else>
    <view class="label">手机号</view><view class="field"><text>+86</text><input type="number" maxlength="11" value="{{phone}}" bindinput="phoneInput" placeholder="请输入手机号" disabled="{{busy}}" /></view>
    <view class="label">短信验证码</view><view class="field"><input type="number" maxlength="6" value="{{code}}" bindinput="codeInput" placeholder="六位验证码" disabled="{{busy}}" /><button bindtap="send" disabled="{{busy || cooldown > 0 || phone.length !== 11}}">{{cooldown ? cooldown + ' 秒后重发' : '获取验证码'}}</button></view>
    <view wx:if="{{notice}}" class="notice">{{notice}}</view><button class="primary" bindtap="login" loading="{{busy}}" disabled="{{busy || phone.length !== 11 || code.length !== 6}}">登录，开始记录</button><view class="note">首次验证成功会自动创建账号</view>
  </block>
  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>
