page{background:#f5f1e8;color:#3b4036}.account{padding:100rpx 48rpx}.mark{width:100rpx;height:100rpx;line-height:100rpx;text-align:center;background:#768469;color:#fff;border-radius:30rpx;font-size:48rpx;margin-bottom:48rpx}.eyebrow{color:#737c68;font-size:24rpx;letter-spacing:4rpx}.title{font-size:46rpx;line-height:1.5;font-weight:600;margin:24rpx 0}.intro{font-size:28rpx;line-height:1.8;color:#777c70;margin-bottom:60rpx}.label{font-size:26rpx;margin:32rpx 0 20rpx}.field{display:flex;align-items:center;background:#fffaf2;border:1rpx solid #d5d9cd;border-radius:20rpx;padding:12rpx}.field text{padding:0 20rpx;border-right:1rpx solid #ddd}.field input{flex:1;min-width:0;padding:18rpx;font-size:30rpx}.field button{font-size:24rpx;white-space:nowrap;background:#e8eddf;color:#526448;margin:0;padding:4rpx 16rpx}.primary{margin-top:48rpx;background:#596d4c;color:white;border-radius:20rpx;font-size:30rpx}.note{font-size:24rpx;text-align:center;color:#858a7f;margin-top:28rpx}.error{color:#9a4338;font-size:26rpx;margin-top:24rpx}.notice{font-size:26rpx;color:#596d4c;margin-top:24rpx}button::after{border:0}
