<view class="folder-nav" style="padding-top: {{statusBarHeight}}px; padding-right: {{navigationRight}}px;">
  <view class="folder-nav-row" style="height: {{navigationHeight}}px;">
    <button class="nav-back" bindtap="exitFolder" aria-label="{{searchOpen || selected ? '返回资料夹' : '返回书桌'}}"><view class="back-chevron" /></button><text wx:if="{{!searchOpen}}" class="nav-title">{{selected ? selected.title : '资料夹'}}</text><input wx:else class="search-page-input" focus="{{searchOpen}}" value="{{query}}" bindinput="searchInput" bindconfirm="searchNow" confirm-type="search" maxlength="200" placeholder="搜索文件名" placeholder-style="color: #969d91;" aria-label="搜索文件名" />
    <button wx:if="{{!searchOpen && !selected}}" class="search-toggle" bindtap="toggleSearch" aria-label="搜索资料"><icon type="search" size="18" color="#858b80" /></button>
    <button wx:if="{{selected}}" class="preview-delete" bindtap="remove" aria-label="删除这份资料" disabled="{{busy}}"><image src="/assets/materials/delete.svg" /></button>
  </view>
</view>
<view class="folder {{selected ? 'folder--preview' : ''}}" style="--preview-space: calc(100vh - {{statusBarHeight + navigationHeight}}px - 310rpx - env(safe-area-inset-bottom));">
  <view wx:if="{{error}}" class="error">{{error}}<button size="mini" bindtap="refresh" disabled="{{busy}}">重新加载</button></view>
  <block wx:if="{{selected}}">
    <image wx:if="{{selected.kind === 'image'}}" class="preview" src="{{previewUrl}}" mode="aspectFit" bindtap="preview" />
    <view wx:elif="{{selected.mimeType === 'application/pdf'}}" class="pdf-preview">
      <view class="pdf-image-stage"><view wx:if="{{pdfLoading}}" class="pdf-status">正在展开第 {{pdfPage}} 页…</view>
      <view wx:elif="{{pdfError}}" class="pdf-status">{{pdfError}}<button bindtap="retryPdf">重试</button></view>
      <image wx:else class="document-preview" src="{{pdfUrl}}" mode="aspectFit" /></view>
      <view class="pdf-pager"><button data-step="-1" bindtap="turnPdf" disabled="{{pdfLoading || pdfPage <= 1}}" aria-label="上一页">‹</button><text>{{pdfPage}} / {{pdfCount || '…'}}</text><button data-step="1" bindtap="turnPdf" disabled="{{pdfLoading || !pdfCount || pdfPage >= pdfCount}}" aria-label="下一页">›</button></view>
    </view>
    <image wx:elif="{{thumbnails[selected.id]}}" class="document-preview" src="{{thumbnails[selected.id]}}" mode="widthFix" bindtap="preview" />
    <view wx:elif="{{selected.text}}" class="document-text"><text selectable>{{selected.text}}</text></view>
    <view wx:else class="hint">这份资料暂不支持页内预览，请打开原件。</view>
    <button class="open-original" bindtap="preview">打开原件</button>

    <view class="fox-chat-footer"><button class="fox-chat" bindtap="chat" disabled="{{busy}}"><text>和令狸聊聊</text><view class="fox-portrait"><image src="/assets/materials/lingli-chat-wave.webp" mode="aspectFit" /></view></button></view>
  </block>
  <block wx:else>
    <view class="results {{leaving ? 'is-leaving' : ''}}">
    <view wx:if="{{loading}}" class="empty">正在打开资料夹…</view>
    <view wx:elif="{{searchOpen && !query}}" class="empty">输入文件名，查找照片或文档</view>
    <view wx:elif="{{searchOpen && query !== renderedQuery}}" class="empty">正在搜索…</view>
    <view wx:elif="{{!visibleItems.length}}" class="empty">{{items.length ? '没有找到资料，试试其他名称或分类。' : '还没有资料，放进第一份回忆吧。'}}</view>
    <view class="material-grid">
      <button wx:for="{{visibleItems}}" wx:key="id" class="material-card" style="animation-delay: {{index > 7 ? 196 : index * 28}}ms" data-id="{{item.id}}" bindtap="select" bindlongpress="fileActions" disabled="{{busy || leaving}}">
        <view class="cover cover--{{item.kind}}">
          <image wx:if="{{thumbnails[item.id]}}" src="{{thumbnails[item.id]}}" mode="aspectFill" />
          <view wx:elif="{{item.kind === 'document'}}" class="paper-content"><view class="paper-sprig"><view /><view /><view /><view /><view /></view><view class="paper-lines" /></view>
          <view wx:else class="cover-placeholder">照片</view>
          <view class="cover-caption"><text>{{item.fileType}}</text><text>{{item.sizeLabel}}</text></view>
        </view>
        <view class="card-title">{{item.title}}</view>
        <view wx:if="{{item.title !== item.filename}}" class="card-filename">{{item.filename}}</view>
      </button>
    </view>
    </view>
    <view wx:if="{{!searchOpen}}" class="dock"><view class="filters"><view class="glass-thumb" style="transform: translateX({{tabIndex * 100}}%);"><view class="glass-shine" style="transform: translateX({{tabIndex * 15 - 20}}%);" /></view>
      <button class="filter {{filter === 'all' ? 'active' : ''}}" aria-label="全部资料" aria-pressed="{{filter === 'all'}}" data-filter="all" bindtap="changeFilter">全部</button>
      <button class="filter {{filter === 'image' ? 'active' : ''}}" aria-label="照片" aria-pressed="{{filter === 'image'}}" data-filter="image" bindtap="changeFilter">照片</button>
      <button class="filter {{filter === 'document' ? 'active' : ''}}" aria-label="文档" aria-pressed="{{filter === 'document'}}" data-filter="document" bindtap="changeFilter">文档</button>
    </view><button class="add" bindtap="add" aria-label="添加资料" loading="{{busy}}" disabled="{{busy || loading}}"><view class="plus" wx:if="{{!busy}}" /></button></view>
  </block>
</view>

<view wx:if="{{actionItem}}" class="file-actions" catchtap="dismissActions" catchtouchmove="keepActions">
  <view class="file-actions-stack" catchtap="keepActions">
    <view class="file-keepsake">
      <view class="cover cover--{{actionItem.kind}}">
        <image wx:if="{{thumbnails[actionItem.id]}}" src="{{thumbnails[actionItem.id]}}" mode="aspectFill" />
        <view wx:elif="{{actionItem.kind === 'document'}}" class="paper-content"><view class="paper-sprig"><view /><view /><view /><view /><view /></view><view class="paper-lines" /></view>
        <view wx:else class="cover-placeholder">照片</view>
        <view class="cover-caption"><text>{{actionItem.fileType}}</text><text>{{actionItem.sizeLabel}}</text></view>
      </view>
      <view class="file-keepsake-title">{{actionItem.title}}</view>
    </view>
    <view class="file-actions-menu">
      <button data-action="preview" bindtap="chooseAction">预览</button>
      <button data-action="chat" bindtap="chooseAction">和令狸聊聊</button>
      <button class="file-action-danger" data-action="delete" bindtap="chooseAction">删除</button>
      <button class="file-action-cancel" bindtap="dismissActions">取消</button>
    </view>
  </view>
</view>
