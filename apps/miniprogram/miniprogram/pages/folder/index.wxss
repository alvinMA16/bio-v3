button { margin: 0; font-size: 28rpx; background: #fffaf1; color: #594735; border-radius: 18rpx; }
button::after { border: 1rpx solid #dfd2c0; }
.primary { background: #97724d; color: white; }
.hint { font-size: 23rpx; color: #94816e; line-height: 1.7; }
.empty { text-align: center; padding: 90rpx 0; color: #94816e; font-size: 27rpx; }
.item { display: flex; align-items: center; gap: 22rpx; padding: 22rpx; text-align: left; line-height: 1.5; }
.icon { background: #ece0ce; width: 72rpx; height: 82rpx; text-align: center; line-height: 82rpx; border-radius: 8rpx; }
.item-info { flex: 1; min-width: 0; }
.item-title { word-break: break-all; }
.preview { width: 100%; height: 380rpx; }
.label { font-size: 26rpx; }
input, textarea { box-sizing: border-box; background: #fffaf1; border: 1rpx solid #dfd2c0; border-radius: 12rpx; padding: 20rpx; width: 100%; }
input { height: 84rpx; }
textarea { height: 190rpx; }
.text-preview { max-height: 360rpx; white-space: pre-wrap; font-size: 26rpx; line-height: 1.8; }
.error, .delete { color: #a04c37; font-size: 26rpx; }
.material-card { background: transparent; padding: 0; text-align: left; line-height: 1.5; border-radius: 0; overflow: visible; }
.material-card::after { border: 0; }
.cover { position: relative; box-sizing: border-box; width: 100%; height: 340rpx; overflow: hidden; }
.cover image { width: 100%; height: 100%; }
.cover--image { padding: 12rpx 12rpx 40rpx; background: #fffdf8; box-shadow: 0 8rpx 15rpx #59473520; border: 1rpx solid #e3d8c8; transform: rotate(-1deg); }
.cover--document { background: #fffdf8; border: 1rpx solid #dfd4c3; border-radius: 4rpx 22rpx 4rpx 4rpx; padding-bottom: 35rpx; box-shadow: 5rpx 5rpx 0 #e5dccd; }
.cover-caption { position: absolute; bottom: 0; left: 0; right: 0; background: #f7f1e6; padding: 7rpx 14rpx; font-size: 15rpx; color: #a39279; }
.cover-placeholder { height: 100%; background: #e9e1d4; display: flex; align-items: center; justify-content: center; color: #af9e87; }
.card-title { margin-top: 20rpx; font-size: 25rpx; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.card-filename { color: #a0907b; font-size: 19rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.count { color: #9c8f7c; font-size: 23rpx; }
.filter::after { border: 0; }
.paper-content { height: 100%; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 32rpx; background: linear-gradient(135deg, #fffcf6, #f1e9db); }
.paper-symbol { font-size: 90rpx; color: #b3a184; line-height: 1; }
.paper-lines { width: 50%; height: 46rpx; background: repeating-linear-gradient(to bottom, #d7cab555 0 2rpx, transparent 2rpx 16rpx); }
.cover-caption { display: flex; justify-content: space-between; padding: 12rpx 16rpx; font-size: 19rpx; }
.cover-caption text:first-child { font-weight: 600; letter-spacing: 1rpx; }
.cover--image { padding-bottom: 54rpx; }
.cover--document { padding-bottom: 50rpx; }

/* Native navigation owns the top bar. Felt lining continues below it. */
.add::after { border: 0; }
.count { color: #827054; }
.cover--document { border-radius: 6rpx; border-color: #d1d0c8; box-shadow: 4rpx 4rpx 0 #f8edda, 6rpx 6rpx 0 #bca98a, 2rpx 10rpx 14rpx #70573627; }
.paper-content { background-color: #f4f4f0; background-blend-mode: luminosity; gap: 30rpx; }
.paper-sprig { position: relative; width: 4rpx; height: 96rpx; border-radius: 100%; background: #929c85; transform: rotate(-18deg); }
.paper-sprig view { position: absolute; width: 24rpx; height: 35rpx; left: -24rpx; top: 14rpx; border-radius: 4rpx 90% 4rpx 90%; background: #8b967e; box-shadow: inset 2rpx 2rpx 4rpx #fff5; }
.paper-sprig view:nth-child(2) { left: 4rpx; top: 30rpx; transform: scaleX(-1); }
.paper-sprig view:nth-child(3) { top: 58rpx; }
.paper-sprig view:nth-child(4) { left: 4rpx; top: 74rpx; transform: scaleX(-1); }
.paper-sprig view:nth-child(5) { left: -7rpx; top: -12rpx; width: 19rpx; height: 28rpx; }
.paper-lines { width: 58%; height: 38rpx; background: repeating-linear-gradient(to bottom, #b1b7a650 0 2rpx, transparent 2rpx 18rpx); }
.cover-caption { color: #777971; background: #efefeb; border-top: 2rpx solid #e0d3bb; }
.card-title { color: #60635c; font-family: 'Songti SC', 'STSong', serif; }
.cover--image { background: #f5f5f1; border-color: #d4d3cb; box-shadow: 2rpx 8rpx 12rpx #555d502b; }

/* Embedded because WXSS does not load packaged local background URLs. */
.folder, .paper-content, .folder-nav { background-image: url("data:image/webp;base64,"); background-size: 600rpx; }

/* Continuous felt background without nested frames or oversized tabs. */
page { background: #e8e7e2; color: #594735; }
.folder { display: flex; flex-direction: column; gap: 20rpx; min-height: 100vh; box-sizing: border-box; margin: 0; padding: 12rpx 30rpx calc(160rpx + env(safe-area-inset-bottom)); background-color: #e8e7e2; background-blend-mode: luminosity; }
.material-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32rpx 30rpx; padding: 0 2rpx; }

.search { display: flex; align-items: center; gap: 16rpx; padding: 0 24rpx; margin-bottom: 16rpx; background: #dfd5c280; border-radius: 20rpx; }
.search input { min-width: 0; height: 80rpx; padding: 18rpx 0; border: 0; background: transparent; font-size: 27rpx; }
.dock { position: fixed; z-index: 10; bottom: calc(22rpx + env(safe-area-inset-bottom)); left: 30rpx; right: 30rpx; display: flex; align-items: center; gap: 16rpx; padding: 10rpx; border-radius: 70rpx; background: linear-gradient(155deg, #ffffff35, #ffffff0d 48%, #dde3dc22); backdrop-filter: blur(18px) saturate(1.65); -webkit-backdrop-filter: blur(18px) saturate(1.65); border: 2rpx solid #ffffff60; box-shadow: 0 10rpx 32rpx #4e42281a; }
.filters { position: relative; display: flex; flex: 1; min-width: 0; align-items: center; }
.filter { position: relative; z-index: 1; flex: 1; min-width: 0; min-height: 88rpx; padding: 20rpx 8rpx; line-height: 48rpx; border: 0; border-radius: 50rpx; background: transparent; color: #7b8376; font-size: 26rpx; }
.filter.active { background: transparent; color: #495747; font-weight: 600; }
.add { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 88rpx; height: 88rpx; padding: 0; border: 0; border-left: 2rpx solid #9da59750; border-radius: 0; background: transparent; color: #64715e; }
.plus { position: relative; width: 40rpx; height: 40rpx; }
.plus::before, .plus::after { content: ''; position: absolute; background: #64715e; border-radius: 2rpx; }
.plus::before { width: 36rpx; height: 4rpx; left: 2rpx; top: 18rpx; }
.plus::after { width: 4rpx; height: 36rpx; top: 2rpx; left: 18rpx; }

.glass-thumb { position: absolute; top: 2rpx; bottom: 2rpx; left: 0; width: 33.333333%; box-sizing: border-box; border-radius: 60rpx; transition: transform 520ms cubic-bezier(.22,1.45,.4,1); background: linear-gradient(135deg,#ffffffc9,#ffffff40 55%,#fff9); border: 2rpx solid #fff9; box-shadow: 0 4rpx 10rpx #62573c22, inset 0 2rpx 2rpx #fff; overflow: hidden; pointer-events: none; }
.glass-shine { position: absolute; inset: 0; border-radius: inherit; background: linear-gradient(110deg,transparent 15%,#fff9 42%,transparent 68%); transition: transform 650ms ease; }
.results { transition: opacity 150ms ease, transform 150ms ease; }
.results.is-leaving { opacity: 0; transform: translateY(-16rpx); pointer-events: none; }
.result-count { display: flex; gap: 18rpx; margin-bottom: 24rpx; color: #887b68; font-size: 23rpx; }
.result-count text { color: #a09482; }
.results:not(.is-leaving) .material-card { --entry-tilt: -.6deg; transform-origin: 50% 80%; animation: card-enter 420ms cubic-bezier(.16,1,.3,1) both; }
.results .material-card:nth-child(even) { --entry-tilt: .6deg; }
@keyframes card-enter {
  from { opacity: 0; transform: translateY(36rpx) rotate(var(--entry-tilt)) scale(.985); }
  65% { opacity: 1; }
  to { opacity: 1; transform: translateY(0) rotate(0) scale(1); }
}
@media (prefers-reduced-motion: reduce) { .glass-thumb, .glass-shine, .results { transition: none; } .results:not(.is-leaving) .material-card { animation: none; } }

.search-toggle { align-self: flex-start; display: flex; align-items: center; justify-content: center; width: 76rpx; height: 68rpx; padding: 0; background: transparent; }
.search-toggle::after { border: 0; }
.cover { display: flex; flex-direction: column; }
.cover image, .paper-content, .cover-placeholder { flex: 1; height: 0; min-height: 0; }
.cover--document { padding: 0; background: #efefeb; box-shadow: 0 4rpx 10rpx #555d5017; }
.cover--image { padding: 12rpx 12rpx 0; }
.cover-caption { position: static; flex-shrink: 0; border: 0; background: #efefeb; }
.cover--image .cover-caption { background: transparent; padding: 14rpx 0; }

.folder-nav { background-color: #e8e7e2; background-blend-mode: luminosity; padding-left: 16rpx; }
.folder-nav-row { display: flex; align-items: center; }
.nav-back { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 80rpx; padding: 0; background: transparent; }
.nav-back::after { border: 0; }
.back-chevron { width: 14rpx; height: 14rpx; border-left: 4rpx solid #656c62; border-bottom: 4rpx solid #656c62; transform: rotate(45deg); }
.nav-title { font-size: 34rpx; line-height: 1; font-weight: 600; color: #50564e; white-space: nowrap; }
.folder-nav .search-toggle { align-self: auto; margin-left: 18rpx; flex-shrink: 0; }

.search-page-input { flex: 1; min-width: 0; height: 66rpx; padding: 12rpx 4rpx; border: 0; border-bottom: 1rpx solid #adb4a650; border-radius: 0; background: transparent; color: #555f50; font-size: 26rpx; }

.folder-nav .nav-title { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
.preview-delete { flex-shrink: 0; padding: 0 12rpx; background: transparent; font-size: 25rpx; color: #976d64; }
.preview-delete::after, .open-original::after { border: 0; }
.folder--preview { padding-bottom: 40rpx; }
.folder--preview .preview { height: 58vh; }
.document-preview { width: 100%; }
.document-text { padding: 30rpx; background: #f6f6f2; font-size: 28rpx; line-height: 1.9; white-space: pre-wrap; overflow-wrap: anywhere; }
.open-original { padding: 10rpx 0; background: transparent; text-align: left; color: #78816f; font-size: 25rpx; }

.folder--preview { padding-bottom: calc(170rpx + env(safe-area-inset-bottom)); }
.fox-chat-footer { position: fixed; left: 30rpx; right: 30rpx; bottom: calc(22rpx + env(safe-area-inset-bottom)); }
.fox-chat { display: flex; align-items: center; justify-content: center; gap: 28rpx; width: 100%; height: 122rpx; padding: 0 32rpx; border: 0; box-shadow: inset 0 2rpx 2rpx #ffffffb3, inset 0 -2rpx 2rpx #acc29b33, 0 8rpx 24rpx #53644b12; border-radius: 34rpx; backdrop-filter: blur(16px) saturate(1.35); -webkit-backdrop-filter: blur(16px) saturate(1.35); background: linear-gradient(135deg, #eff7eac4, #c6d8bb85); color: #4f6149; font-size: 30rpx; font-weight: 500; overflow: visible; line-height: 1.4; }
.fox-chat::after { border: 0; }
.fox-portrait { margin-left: 0; position: relative; width: 144rpx; height: 150rpx; flex-shrink: 0; overflow: hidden; align-self: flex-end; }
.fox-portrait image { display: block; width: 100%; height: 100%; pointer-events: none; }

.preview-delete { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 80rpx; padding: 0; }
.preview-delete image { width: 38rpx; height: 38rpx; }

.file-actions { position: fixed; inset: 0; z-index: 30; display: flex; align-items: center; justify-content: center; padding: 48rpx; background: #383e394d; backdrop-filter: blur(7px); -webkit-backdrop-filter: blur(7px); }
.file-actions-stack { width: 100%; max-width: 560rpx; display: flex; flex-direction: column; align-items: center; gap: 52rpx; }
.file-keepsake { width: 270rpx; padding: 14rpx 14rpx 20rpx; box-sizing: border-box; background: #f5f5f1; border-radius: 6rpx; transform: rotate(-5deg); box-shadow: 0 32rpx 56rpx #252d3433, 0 4rpx 8rpx #252d3414; animation: keepsake-in 360ms ease both; }
.file-keepsake .cover { height: 230rpx; transform: none; border: 0; border-radius: 2rpx; box-shadow: none; padding: 0; }
.file-keepsake .cover-caption { font-size: 17rpx; padding: 10rpx 12rpx; }
.file-keepsake-title { padding: 16rpx 6rpx 0; font-size: 23rpx; color: #636962; text-align: center; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; word-break: break-all; line-height: 1.5; }
.file-actions-menu { width: 88%; padding: 4rpx 32rpx; box-sizing: border-box; border: 1rpx solid #ffffff55; border-radius: 26rpx; background: linear-gradient(140deg,#f8f9f7df,#eef0edc9); box-shadow: 0 16rpx 44rpx #252d3417; overflow: hidden; }
.file-actions-menu button { width: 100%; height: 96rpx; display: flex; align-items: center; justify-content: center; margin: 0; border: 0; border-radius: 0; background: transparent; padding: 0; text-align: center; font-size: 28rpx; font-weight: 400; color: #505953; }
.file-actions-menu button::after { border: 0; }
.file-actions-menu button + button { border-top: 1rpx solid #69756b0d; }
.file-actions-menu .file-action-danger { color: #aa716b; }
.file-actions-menu .file-action-cancel { color: #8a908a; font-weight: 400; }
@keyframes keepsake-in { from { opacity: 0; transform: translateY(24rpx) rotate(-1deg) scale(.95); } to { opacity: 1; transform: rotate(-5deg); } }
@media (prefers-reduced-motion: reduce) { .file-keepsake { animation: none; } }

.pdf-pager { display: flex; align-items: center; justify-content: center; gap: 40rpx; margin-top: 20rpx; padding: 8rpx 0; color: #596750; font-size: 25rpx; }
.pdf-pager button { margin: 0; width: 88rpx; height: 88rpx; padding: 0; background: transparent; font-size: 48rpx; line-height: 88rpx; }
.pdf-pager button::after { border: 0; }
.pdf-status { min-height: 520rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24rpx; color: #80887c; font-size: 26rpx; }

.folder--preview .preview { height: var(--preview-space); }
.pdf-preview { height: var(--preview-space); display: flex; flex-direction: column; }
.pdf-image-stage { flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; }
.pdf-image-stage .document-preview { width: 100%; height: 100%; }
.pdf-image-stage .pdf-status { min-height: 0; }
.pdf-pager { flex-shrink: 0; }
