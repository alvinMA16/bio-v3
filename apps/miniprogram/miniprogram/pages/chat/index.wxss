.page {
  box-sizing: border-box;
  display: flex;
  height: 100vh;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}

.chat-exit { padding: 12rpx 32rpx; text-align: right; }
.chat-exit button { display: inline-block; padding: 0 22rpx; line-height: 64rpx; font-size: 23rpx; color: #72644f; background: #f0e9da; border-radius: 32rpx; }

.messages {
  box-sizing: border-box;
  flex: 1;
  min-height: 0;
  padding: 32rpx;
}

.empty {
  padding: 26vh 32rpx 0;
  text-align: center;
}

.empty__title {
  font-size: 44rpx;
  font-weight: 600;
}

.empty__hint {
  margin-top: 16rpx;
  color: #77776f;
  font-size: 28rpx;
}

.message {
  display: flex;
  margin-bottom: 24rpx;
}

.message--user {
  justify-content: flex-end;
}

.message__bubble {
  box-sizing: border-box;
  max-width: 82%;
  padding: 22rpx 26rpx;
  border-radius: 28rpx;
  background: #fff;
  font-size: 30rpx;
  line-height: 1.55;
  white-space: pre-wrap;
}

.message--user .message__bubble {
  background: #171714;
  color: #fff;
  border-bottom-right-radius: 8rpx;
}

.message--assistant .message__bubble {
  border-bottom-left-radius: 8rpx;
}

.composer {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  margin: 16rpx 24rpx 24rpx;
  padding: 16rpx 18rpx 16rpx 26rpx;
  border: 1rpx solid #e5e5df;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 12rpx 40rpx rgba(20, 20, 18, 0.06);
}

.composer__input {
  width: auto;
  min-height: 52rpx;
  max-height: 220rpx;
  flex: 1;
  padding: 8rpx 0;
  font-size: 30rpx;
  line-height: 1.45;
}

.composer__send {
  width: 108rpx;
  height: 68rpx;
  margin: 0;
  padding: 0;
  border-radius: 34rpx;
  background: #b7f34b;
  color: #171714;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 68rpx;
}

.composer__send[disabled] {
  background: #e8e8e2;
  color: #999991;
}

.work-panel { padding: 24rpx; margin-top: 24rpx; background: #fff; border-radius: 20rpx; white-space: pre-wrap; }
.work-panel__title { font-weight: 600; margin-bottom: 20rpx; }
.work-panel__image { width: 100%; }
.work-panel__block { padding: 16rpx; border: 2rpx solid transparent; }
.work-panel__block--selected { border-color: #88b63d; background: #f3f9e8; }
.work-panel__block--heading { font-weight: 600; font-size: 34rpx; }
.work-panel__block--quote { border-left: 4rpx solid #aaa; color: #666; }
.work-panel__block--code { font-family: monospace; background: #f1f1ed; }
.work-panel__hint { color: #777; font-size: 24rpx; margin-top: 16rpx; }

.voice-controls { padding: 16rpx 24rpx; display: flex; flex-direction: column; gap: 12rpx; font-size: 24rpx; }
.voice-buttons { display: flex; gap: 8rpx; }
.voice-buttons button { font-size: 24rpx; padding: 0 12rpx; }

.page--call { background: #1c1f24; color: #f4f5f7; height: 100%; min-height: 100vh; }
.call-header { display: flex; justify-content: space-between; align-items: center; padding: 32rpx 40rpx 24rpx; }
.call-name { font-size: 48rpx; }
.call-duration { margin-top: 16rpx; font-size: 25rpx; color: #a9afb9; }
.call-video { position: relative; width: 210rpx; height: 260rpx; border-radius: 28rpx; overflow: hidden; background: #d8c5a8; }
.call-scene { position: absolute; width: 350rpx; height: 757rpx; left: -70rpx; top: -145rpx; }
.call-layer { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.call-actor { position: absolute; max-width: none; }
.page--call .messages { padding: 28rpx 40rpx; }
.call-subtitle { font-size: 38rpx; line-height: 1.85; white-space: pre-wrap; overflow-wrap: anywhere; }
.page--call .work-panel { margin: 0; background: #f7f8fa; color: #242830; }
.call-controls { padding: 16rpx 30rpx 40rpx; }
.call-status, .call-transcript { text-align: center; font-size: 24rpx; line-height: 1.6; color: #a9afb9; margin-bottom: 20rpx; }
.call-transcript { max-height: 140rpx; overflow: auto; }
.call-buttons { display: flex; justify-content: center; gap: 22rpx; }
.call-buttons button { margin: 0; padding: 0 26rpx; border-radius: 48rpx; background: #363c45; color: #f4f5f7; font-size: 25rpx; line-height: 88rpx; }
.call-buttons button[disabled] { color: #717984; background: #292e35; }
.call-buttons .call-end { background: #e5484d; color: #fff; }
