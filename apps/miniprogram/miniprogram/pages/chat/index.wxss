.page {
  box-sizing: border-box;
  display: flex;
  height: 100vh;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}

.messages {
  box-sizing: border-box;
  flex: 1;
  min-height: 0;
  padding: 32rpx;
}

.empty {
  padding: 26vh 32rpx 0;
  text-align: center;
}

.empty__title {
  font-size: 44rpx;
  font-weight: 600;
}

.empty__hint {
  margin-top: 16rpx;
  color: #77776f;
  font-size: 28rpx;
}

.message {
  display: flex;
  margin-bottom: 24rpx;
}

.message--user {
  justify-content: flex-end;
}

.message__bubble {
  box-sizing: border-box;
  max-width: 82%;
  padding: 22rpx 26rpx;
  border-radius: 28rpx;
  background: #fff;
  font-size: 30rpx;
  line-height: 1.55;
  white-space: pre-wrap;
}

.message--user .message__bubble {
  background: #171714;
  color: #fff;
  border-bottom-right-radius: 8rpx;
}

.message--assistant .message__bubble {
  border-bottom-left-radius: 8rpx;
}

.composer {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  margin: 16rpx 24rpx 24rpx;
  padding: 16rpx 18rpx 16rpx 26rpx;
  border: 1rpx solid #e5e5df;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 12rpx 40rpx rgba(20, 20, 18, 0.06);
}

.composer__input {
  width: auto;
  min-height: 52rpx;
  max-height: 220rpx;
  flex: 1;
  padding: 8rpx 0;
  font-size: 30rpx;
  line-height: 1.45;
}

.composer__send {
  width: 108rpx;
  height: 68rpx;
  margin: 0;
  padding: 0;
  border-radius: 34rpx;
  background: #b7f34b;
  color: #171714;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 68rpx;
}

.composer__send[disabled] {
  background: #e8e8e2;
  color: #999991;
}
