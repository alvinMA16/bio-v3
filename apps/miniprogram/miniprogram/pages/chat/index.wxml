<view class="page {{callMode ? 'page--call' : ''}} {{panel.mode === 'attachment' ? 'page--attachment' : ''}} {{attachmentFocused ? 'page--focused' : ''}}">
  <view wx:if="{{callMode}}" class="call-header">
    <view><view class="call-name">令狸</view><view class="call-duration">{{callDuration}}</view></view>
    <view class="call-video" aria-label="令狸的对话画面">
      <view class="call-scene">
        <image class="call-layer" src="/assets/animations/fox-clerk/environment.webp" mode="scaleToFill" />
        <image wx:for="{{actorSheets}}" wx:key="id" class="call-actor" src="{{item.src}}" data-action="{{item.id}}" bindload="onActorLoaded" mode="scaleToFill" style="width: {{item.columns * 100}}%; height: {{item.rows * 100}}%; left: {{actorSrc === item.src ? actorLeft : 0}}%; top: {{actorSrc === item.src ? actorTop : 0}}%; visibility: {{actorReady && actorSrc === item.src ? 'visible' : 'hidden'}};" />
        <image class="call-layer" src="/assets/animations/fox-clerk/inner-panel.webp" mode="scaleToFill" />
      </view>
    </view>
  </view>
  <view wx:if="{{!callMode}}" class="chat-exit"><button bindtap="leaveChat">结束聊天 · 领取小票</button></view>
  <view wx:if="{{materialTitle && !callMode}}" class="material-selection">已选资料：{{materialTitle}}<button size="mini" bindtap="clearMaterial" disabled="{{sending || voiceActive}}">取消选择</button></view>
  <view wx:if="{{callMode && attachmentFocused}}" class="focus-status">通话继续 · {{callDuration}}</view>
  <view wx:if="{{panel.mode === 'attachment'}}" class="attachment-container"><attachment-viewer attachment="{{panel.attachment}}" focused="{{attachmentFocused}}" bindfocus="toggleAttachmentFocus" bindpage="attachmentPage" /></view>
  <scroll-view wx:else class="messages" scroll-y enhanced scroll-into-view="{{panel.mode === 'editor' ? documentScrollAnchor : 'bottom-anchor'}}" bindscroll="documentScroll" bindtouchmove="documentTouchMove">
    <view wx:if="{{callMode && panel.mode === 'conversation'}}" class="call-subtitle">{{callSubtitle || '我在这里，慢慢讲。'}}</view>
    <view wx:if="{{!callMode && messages.length === 0}}" class="empty">
      <view class="empty__title">今天想聊点什么？</view>
      <view class="empty__hint">我可以陪你分析、整理和执行任务。</view>
    </view>
    <view
      wx:if="{{!callMode}}"
      wx:for="{{messages}}"
      wx:key="id"
      class="message message--{{item.role}}"
    >
      <view class="message__bubble">{{item.content}}</view>
    </view>
    <view wx:if="{{panel.mode !== 'conversation'}}" class="work-panel">
      <view wx:if="{{panel.mode === 'attachment'}}">
        <view class="work-panel__title">{{panel.attachment.title}}</view>
        <text wx:if="{{panel.attachment.originalStatus}}">{{panel.attachment.originalStatus === 'deleted' ? '原文件已删除' : '原文件不可用'}}，已有对话仍保留。查看或核对原文需重新上传。</text>
        <image wx:elif="{{panel.attachment.kind === 'image'}}" src="{{panel.attachment.url}}" mode="widthFix" class="work-panel__image" />
        <text wx:else selectable>{{panel.attachment.text || panel.attachment.url}}</text>
      </view>
      <view wx:if="{{panel.mode === 'editor'}}" class="work-panel__hint">{{agentWorking || sending ? '正在整理文稿，完成后会保存到文稿集…' : '本轮已结束；已写入的草稿可在文稿集中查看。'}}</view>
      <view wx:if="{{panel.mode === 'editor' && !panel.document && !agentWorking && !sending}}">正文尚未生成成功，可以请令狸重新整理。</view>
      <view wx:if="{{panel.mode === 'editor' && panel.document}}">
        <view id="document-title" class="work-panel__title">{{panel.document.title}} · 版本 {{panel.document.version}}</view>
        <view wx:for="{{documentBlocks}}" wx:key="id" class="work-panel__block work-panel__block--{{item.kind}}">
          <text wx:for="{{item.fragments}}" wx:for-item="fragment" wx:key="id" id="{{fragment.id}}" class="document-fragment" data-block="{{fragment.blockId}}" data-start="{{fragment.start}}" data-end="{{fragment.end}}">{{fragment.text}}</text>
        </view>
      </view>
    </view>
    <view id="bottom-anchor"></view>
  </scroll-view>

  <view wx:if="{{callMode}}" class="call-controls">
    <view class="call-status">{{voiceStatus || '正在连接'}}{{audioPlaying ? ' · 正在播放' : ''}}</view>
    <view wx:if="{{voiceTranscript && panel.mode !== 'attachment'}}" class="call-transcript">{{voiceTranscript}}</view>
    <view class="call-buttons">
      <button wx:if="{{!voiceActive}}" bindtap="startVoice">重新连接</button>
      <button wx:else bindtap="finishVoice" disabled="{{voiceStatus !== '正在听你说'}}">说完了</button>
      <button class="call-end" bindtap="leaveChat">结束通话</button>
      <button bindtap="interruptVoice" disabled="{{!voiceActive || voiceStatus === '正在听你说'}}">打断</button>
    </view>
  </view>
  <view wx:else class="voice-controls">
    <button wx:if="{{!voiceActive}}" bindtap="startVoice" disabled="{{sending || voiceActive}}">开始语音对话</button>
    <block wx:else>
      <text>{{voiceStatus}} {{audioPlaying ? '· 正在播放' : ''}}</text>
      <text>{{voiceTranscript}}</text>
      <view class="voice-buttons">
        <button bindtap="finishVoice" disabled="{{voiceStatus !== '正在听你说'}}">说完了</button>
        <button bindtap="interruptVoice" disabled="{{voiceStatus === '正在听你说'}}">打断并说话</button>
        <button bindtap="stopVoice">结束语音</button>
      </view>
    </block>
  </view>
  <view wx:if="{{!callMode}}" class="composer">
    <textarea
      class="composer__input"
      value="{{input}}"
      placeholder="给令狸发消息"
      auto-height
      maxlength="20000"
      disabled="{{sending || voiceActive}}"
      bindinput="onInput"
      bindconfirm="sendMessage"
    />
    <button
      class="composer__send"
      disabled="{{sending || voiceActive || !input}}"
      bindtap="sendMessage"
    >{{sending ? '···' : '发送'}}</button>
  </view>
</view>
