<view class="page">
  <scroll-view class="messages" scroll-y enhanced scroll-into-view="bottom-anchor">
    <view wx:if="{{messages.length === 0}}" class="empty">
      <view class="empty__title">今天想聊点什么？</view>
      <view class="empty__hint">我可以陪你分析、整理和执行任务。</view>
    </view>
    <view
      wx:for="{{messages}}"
      wx:key="id"
      class="message message--{{item.role}}"
    >
      <view class="message__bubble">{{item.content}}</view>
    </view>
    <view wx:if="{{panel.mode !== 'conversation'}}" class="work-panel">
      <view wx:if="{{panel.mode === 'attachment'}}">
        <view class="work-panel__title">{{panel.attachment.title}}</view>
        <image wx:if="{{panel.attachment.kind === 'image'}}" src="{{panel.attachment.url}}" mode="widthFix" class="work-panel__image" />
        <text wx:else selectable>{{panel.attachment.text || panel.attachment.url}}</text>
      </view>
      <view wx:if="{{panel.mode === 'editor' && !panel.document}}">还没有文档内容。</view>
      <view wx:if="{{panel.mode === 'editor' && panel.document}}">
        <view class="work-panel__title">{{panel.document.title}} · 版本 {{panel.document.version}}</view>
        <view wx:for="{{panel.document.blocks}}" wx:key="id" class="work-panel__block work-panel__block--{{item.kind}} {{selectedBlockId === item.id ? 'work-panel__block--selected' : ''}}" bindtap="selectBlock" data-id="{{item.id}}">
          <text selectable>{{item.text}}</text>
        </view>
        <view class="work-panel__hint">点选一段后，可以让令狸修改；草稿已保存在本地会话。</view>
      </view>
    </view>
    <view id="bottom-anchor"></view>
  </scroll-view>

  <view class="voice-controls">
    <button wx:if="{{!voiceActive}}" bindtap="startVoice" disabled="{{sending || voiceActive}}">开始语音对话</button>
    <block wx:else>
      <text>{{voiceStatus}} {{audioPlaying ? '· 正在播放' : ''}}</text>
      <text>{{voiceTranscript}}</text>
      <view class="voice-buttons">
        <button bindtap="finishVoice" disabled="{{voiceStatus !== '正在听你说'}}">说完了</button>
        <button bindtap="interruptVoice" disabled="{{voiceStatus === '正在听你说'}}">打断并说话</button>
        <button bindtap="stopVoice">结束语音</button>
      </view>
    </block>
  </view>
  <view class="composer">
    <textarea
      class="composer__input"
      value="{{input}}"
      placeholder="给令狸发消息"
      auto-height
      maxlength="20000"
      disabled="{{sending || voiceActive}}"
      bindinput="onInput"
      bindconfirm="sendMessage"
    />
    <button
      class="composer__send"
      disabled="{{sending || voiceActive || !input}}"
      bindtap="sendMessage"
    >{{sending ? '···' : '发送'}}</button>
  </view>
</view>
