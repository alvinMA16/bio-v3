<view class="manuscripts">
  <button wx:if="{{document || error}}" bindtap="back">返回文稿列表</button>
  <view wx:if="{{loading}}">正在读取文稿…</view>
  <view wx:elif="{{error}}">{{error}}</view>
  <view wx:elif="{{document}}">
    <view class="title">{{document.title}}</view><view class="version">已保存草稿 · 版本 {{document.version}}</view>
    <view wx:for="{{document.blocks}}" wx:key="id" class="block {{item.kind === 'heading' ? 'heading' : ''}}">{{item.text}}</view>
  </view>
  <view wx:else>
    <button wx:for="{{items}}" wx:key="index" data-index="{{index}}" bindtap="select">{{item.title}}<view class="version">已保存草稿 · 版本 {{item.version}}</view></button>
    <view wx:if="{{!items.length}}">还没有已保存的文稿。通话中可以请令狸帮你整理。</view>
  </view>
</view>
