<view class="stage">
  <image class="stage__layer" src="{{environmentSrc}}" mode="scaleToFill" />
  <view class="stage__layer stage__actor">
    <image
      class="stage__sheet {{activeAction === 'blink' ? 'stage__sheet--active' : ''}}"
      src="{{blinkSrc}}"
      mode="scaleToFill"
      style="width: 400%; height: 300%; left: {{blinkLeftPercent}}%; top: {{blinkTopPercent}}%;"
    />
    <image
      class="stage__sheet {{activeAction === 'talk' ? 'stage__sheet--active' : ''}}"
      src="{{talkSrc}}"
      mode="scaleToFill"
      style="width: 400%; height: 400%; left: {{talkLeftPercent}}%; top: {{talkTopPercent}}%;"
    />
    <image
      class="stage__sheet {{activeAction === 'wave' ? 'stage__sheet--active' : ''}}"
      src="{{waveSrc}}"
      mode="scaleToFill"
      style="width: 400%; height: 400%; left: {{waveLeftPercent}}%; top: {{waveTopPercent}}%;"
    />
    <image
      class="stage__sheet {{activeAction === 'note' ? 'stage__sheet--active' : ''}}"
      src="{{noteSrc}}"
      mode="scaleToFill"
      style="width: 400%; height: 400%; left: {{noteLeftPercent}}%; top: {{noteTopPercent}}%;"
    />
    <image
      class="stage__sheet {{activeAction === 'nod' ? 'stage__sheet--active' : ''}}"
      src="{{nodSrc}}"
      mode="scaleToFill"
      style="width: 400%; height: 400%; left: {{nodLeftPercent}}%; top: {{nodTopPercent}}%;"
    />
    <image
      class="stage__sheet {{activeAction === 'notebookTalk' ? 'stage__sheet--active' : ''}}"
      src="{{notebookTalkSrc}}"
      mode="scaleToFill"
      style="width: 400%; height: 400%; left: {{notebookTalkLeftPercent}}%; top: {{notebookTalkTopPercent}}%;"
    />
  </view>
  <image class="stage__layer stage__panel" src="{{innerPanelSrc}}" mode="scaleToFill" />
  <view wx:if="{{!receiptVisible}}" class="desk-home">
    <button class="desk-entry desk-entry--folder" hover-class="desk-entry--pressed" bindtap="openFolder" aria-label="资料夹，查看你的资料">
      <image class="desk-entry__icon" src="/assets/desk/folder.png" mode="aspectFit" />
      <view class="desk-entry__name">资料夹</view>
    </button>
    <button class="desk-entry desk-entry--call" hover-class="desk-entry--pressed" bindtap="callLingli" aria-label="呼叫令狸，开始聊天">
      <image class="desk-entry__icon" src="/assets/desk/phone.png" mode="aspectFit" />
      <view class="desk-entry__name">呼叫令狸</view>
    </button>
    <button class="desk-entry desk-entry--manuscripts" hover-class="desk-entry--pressed" bindtap="openManuscripts" aria-label="文稿集，查看整理好的文稿">
      <image class="desk-entry__icon" src="/assets/desk/manuscripts.png" mode="aspectFit" />
      <view class="desk-entry__name">文稿集</view>
    </button>
    <button wx:if="{{receipt}}" class="last-receipt" bindtap="openReceipt">上次聊天小票</button>
  </view>
</view>

<view wx:if="{{receiptVisible && receipt}}" class="receipt-printer">
  <view class="receipt-slot"><view class="receipt-slot__mouth"></view><view class="receipt-slot__light"></view></view>
  <view class="receipt-feed">
    <view class="receipt-paper">
      <scroll-view scroll-y class="receipt-scroll">
        <view class="receipt-paper__brand">令 狸 的 故 事 收 集 处</view>
        <view class="receipt-paper__title">聊天留念</view>
        <view class="receipt-paper__date">{{receipt.date}} · {{receipt.timeRange}}</view>
        <view class="receipt-paper__rule"></view>
        <view class="receipt-paper__row"><text>相伴时长</text><text>{{receipt.duration}}</text></view>
        <view class="receipt-paper__row"><text>你说了</text><text>{{receipt.shares}} 次</text></view>
        <view class="receipt-paper__row"><text>令狸回应</text><text>{{receipt.replies}} 次</text></view>
        <view class="receipt-paper__rule"></view>
        <view wx:if="{{receipt.topics.length}}" class="receipt-paper__topics"><text wx:for="{{receipt.topics}}" wx:key="*this"># {{item}}</text></view>
        <view class="receipt-paper__summary" selectable>{{receipt.summary}}</view>
        <view wx:if="{{receipt.status !== 'ready'}}" class="receipt-paper__status">{{receipt.status === 'pending' ? '正在写下这次的小小回忆…' : receipt.status === 'excerpt' ? '先留住你说的这一句。' : '根据聊天整理'}}</view>
        <view class="receipt-paper__rule"></view>
        <view class="receipt-paper__thanks">谢谢你，愿意说给我听。</view>
        <view class="receipt-paper__memento"><view class="receipt-paper__barcode"></view><view class="receipt-paper__stamp">令狸 · 留念</view></view>
      </scroll-view>
    </view>
  </view>
  <button class="receipt-keep" bindtap="closeReceipt">我知道了</button>
</view>

<view wx:if="{{activeDrawer}}" class="drawer-backdrop" bindtap="closeDrawer">
  <view class="drawer" catchtap="keepDrawerOpen">
    <view class="drawer__handle"></view>
    <button class="drawer__close" bindtap="closeDrawer" aria-label="关闭">×</button>
    <view class="drawer__eyebrow">令狸的书桌</view>
    <view class="drawer__title">{{activeDrawer === 'folder' ? '资料夹' : '文稿集'}}</view>
    <view class="drawer__empty">{{activeDrawer === 'folder' ? '给你的点滴，留一个位置' : '故事，从一次聊天开始'}}</view>
    <view class="drawer__description">{{activeDrawer === 'folder' ? '这里将收纳你的个人资料、照片和生活片段。' : '这里将收录整理好的文稿，方便你随时翻阅。'}}</view>
    <view class="drawer__note">{{activeDrawer === 'folder' ? '资料收纳功能正在准备中' : '文稿收录功能正在准备中'}}</view>
    <button class="drawer__action" bindtap="callLingli">先和令狸聊聊</button>
  </view>
</view>
