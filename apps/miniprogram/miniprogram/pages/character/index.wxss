.stage {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #d8c5a8;
}

.last-receipt { margin: auto 0 0; padding: 14rpx 26rpx; background: #faf3e3b8; color: #81735d; font-size: 22rpx; line-height: 1.5; border-radius: 8rpx; }
.receipt-printer { position: fixed; z-index: 5; top: 50.5%; bottom: calc(3% + env(safe-area-inset-bottom)); left: 12%; right: 12%; display: flex; flex-direction: column; align-items: center; color: #5e5546; }
.receipt-slot { position: relative; z-index: 2; flex-shrink: 0; width: 100%; height: 30rpx; border-radius: 16rpx; background: linear-gradient(#b5a68e, #e2d6c2 48%, #f6edde); box-shadow: inset 0 2rpx 7rpx #64503b50, 0 2rpx 0 #fff9e7; animation: receipt-slot-in 300ms ease-out both; }
.receipt-slot__mouth { position: absolute; top: 9rpx; right: 21rpx; bottom: 7rpx; left: 21rpx; border-radius: 7rpx; background: #4d473b; box-shadow: inset 0 5rpx 7rpx #241f19, 0 2rpx 0 #fff9e788; }
.receipt-slot__light { position: absolute; top: 12rpx; right: 9rpx; width: 7rpx; height: 7rpx; border-radius: 50%; background: #97a478; animation: receipt-light 450ms steps(2) 6; }
.receipt-feed { position: relative; width: 100%; flex: 1; min-height: 0; margin-top: -12rpx; padding: 0 28rpx 21rpx; box-sizing: border-box; overflow: hidden; animation: receipt-feed 2600ms 300ms linear both; }
.receipt-paper { position: relative; height: 100%; box-sizing: border-box; padding: 28rpx 30rpx 23rpx; background: repeating-linear-gradient(0deg, #b5a38106 0, #b5a38106 2rpx, transparent 2rpx, transparent 7rpx), linear-gradient(100deg, #f3ebd9, #fffdf2 12%, #fcf7e9 88%, #eae0cb); box-shadow: 5rpx 12rpx 21rpx #6c573d26, inset 0 16rpx 14rpx -14rpx #67513870; }
.receipt-paper::after { content: ''; position: absolute; top: 100%; left: 0; right: 0; height: 16rpx; background: linear-gradient(135deg, #fcf7e9 25%, transparent 25%) -12rpx 0, linear-gradient(225deg, #fcf7e9 25%, transparent 25%) -12rpx 0; background-size: 24rpx 24rpx; }
.receipt-scroll { height: 100%; }
.receipt-paper__brand { text-align: center; font-size: 17rpx; color: #988b75; letter-spacing: 2rpx; }
.receipt-paper__title { text-align: center; font-family: serif; font-size: 44rpx; letter-spacing: 9rpx; margin: 16rpx 0; }
.receipt-paper__date { text-align: center; font-family: monospace; font-size: 19rpx; line-height: 1.7; color: #8c806d; }
.receipt-paper__rule { border-top: 2rpx dashed #bdb19a; margin: 16rpx 0; }
.receipt-paper__row { display: flex; justify-content: space-between; margin: 12rpx 0; font-size: 24rpx; }
.receipt-paper__row text:last-child { font-family: monospace; }
.receipt-paper__topics { display: flex; flex-wrap: wrap; gap: 14rpx; font-size: 19rpx; color: #83775f; }
.receipt-paper__summary { font-family: serif; font-size: 26rpx; line-height: 1.7; overflow-wrap: anywhere; margin: 14rpx 0; }
.receipt-paper__status { font-size: 17rpx; color: #a2947e; line-height: 1.5; margin: 12rpx 0; }
.receipt-paper__thanks { text-align: center; font-family: serif; font-size: 24rpx; margin: 14rpx 0; }
.receipt-paper__stamp { width: 132rpx; margin: 16rpx auto; padding: 7rpx 18rpx; border: 2rpx solid #ac795d99; border-radius: 50%; color: #a57a60; font-family: serif; font-size: 21rpx; text-align: center; transform: rotate(-9deg); }
.receipt-paper__barcode { width: 178rpx; height: 28rpx; margin: 16rpx auto; opacity: .48; background: repeating-linear-gradient(90deg, #75664f 0 2rpx, transparent 2rpx 7rpx, #75664f 7rpx 12rpx, transparent 12rpx 14rpx, #75664f 14rpx 16rpx, transparent 16rpx 23rpx); }
.receipt-keep { margin-top: 21rpx; flex-shrink: 0; border: 2rpx solid #cabc9f; border-radius: 42rpx; padding: 0 61rpx; line-height: 70rpx; background: #f7f0e1; color: #75664e; font-size: 26rpx; box-shadow: 0 5rpx 7rpx #77634b12; }
@keyframes receipt-slot-in { from { opacity: 0; transform: scaleX(.88); } to { opacity: 1; transform: scaleX(1); } }
@keyframes receipt-feed { 0% { clip-path: inset(0 0 100%); transform: translateY(-14rpx); } 25% { clip-path: inset(0 0 74%); transform: translateY(-9rpx); } 29% { clip-path: inset(0 0 74%); transform: translateY(-9rpx); } 62% { clip-path: inset(0 0 35%); transform: translateY(-5rpx); } 67% { clip-path: inset(0 0 35%); transform: translateY(-5rpx); } 100% { clip-path: inset(0); transform: translateY(0); } }
@keyframes receipt-light { to { opacity: .35; } }
@media (prefers-reduced-motion: reduce) { .receipt-slot, .receipt-feed, .receipt-slot__light { animation: none; } }

.stage__layer, .stage__actor { position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; }
.stage__actor { z-index: 1; overflow: hidden; }
.stage__sheet { position: absolute; max-width: none; opacity: 0; pointer-events: none; }
.stage__sheet--active { opacity: 1; }
.stage__panel { z-index: 2; }
/* Generated transparent props placed freely on the felt desktop. */
.desk-home { position: absolute; z-index: 3; top: 51%; right: 44rpx; bottom: calc(38rpx + env(safe-area-inset-bottom)); left: 44rpx; color: #625442; }
.desk-entry { position: absolute; box-sizing: border-box; width: 260rpx; margin: 0; padding: 0 0 12rpx; overflow: visible; border: 0; border-radius: 24rpx; background: transparent; color: inherit; line-height: 1.4; transition: transform 180ms ease; }
.desk-entry--folder { top: 3%; left: 0; }
.desk-entry--call { top: 24%; right: 0; width: 310rpx; }
.desk-entry--manuscripts { bottom: 1%; left: 44rpx; width: 248rpx; }
.desk-entry--pressed { transform: translateY(5rpx) scale(.96); }
.desk-entry__icon { display: block; width: 100%; height: 250rpx; }
.desk-entry--folder .desk-entry__icon { transform: rotate(-9deg); }
.desk-entry--call .desk-entry__icon { height: 296rpx; transform: rotate(5deg); }
.desk-entry--manuscripts .desk-entry__icon { height: 238rpx; transform: rotate(-7deg); }
.desk-entry__name { margin-top: 0; font-size: 28rpx; font-weight: 500; letter-spacing: 3rpx; text-shadow: 0 1rpx 2rpx #fff9ed; }
.desk-entry--call .desk-entry__name { font-weight: 600; }
.last-receipt { position: absolute; right: 8rpx; bottom: 4rpx; }
.drawer-backdrop { position: fixed; z-index: 10; top: 0; right: 0; bottom: 0; left: 0; background: #30291f66; display: flex; align-items: flex-end; }
.drawer { position: relative; box-sizing: border-box; width: 100%; padding: 22rpx 48rpx calc(42rpx + env(safe-area-inset-bottom)); border-radius: 38rpx 38rpx 0 0; background: #f7f2e8; color: #514a3e; box-shadow: 0 -12rpx 60rpx #30291f16; }
.drawer__handle { width: 60rpx; height: 7rpx; margin: 0 auto 36rpx; border-radius: 9rpx; background: #d5caba; }
.drawer__close { position: absolute; right: 24rpx; top: 25rpx; margin: 0; padding: 0; width: 72rpx; height: 72rpx; font-size: 43rpx; line-height: 72rpx; background: transparent; color: #8a8071; }
.drawer__eyebrow { color: #9b8f7b; font-size: 22rpx; letter-spacing: 3rpx; }
.drawer__title { margin-top: 12rpx; font-size: 44rpx; }
.drawer__empty { margin-top: 58rpx; font-size: 30rpx; }
.drawer__description { margin-top: 18rpx; color: #867b6a; font-size: 26rpx; line-height: 1.8; }
.drawer__note { margin-top: 24rpx; color: #a19583; font-size: 22rpx; }
.drawer__action { margin-top: 44rpx; background: #79866b; color: #fff9ed; border-radius: 18rpx; font-size: 28rpx; line-height: 88rpx; }
@media (max-height: 700px) {
  .desk-home { top: 50%; bottom: calc(24rpx + env(safe-area-inset-bottom)); }
  .desk-entry--folder { width: 224rpx; }
  .desk-entry--call { width: 268rpx; top: 22%; }
  .desk-entry--manuscripts { width: 216rpx; bottom: 0; }
  .desk-entry__icon { height: 206rpx; }
  .desk-entry--call .desk-entry__icon { height: 250rpx; }
  .desk-entry--manuscripts .desk-entry__icon { height: 194rpx; }
  .desk-entry__name { font-size: 26rpx; }
}

.receipt-paper__memento { display: flex; align-items: center; justify-content: center; gap: 22rpx; }
.receipt-paper__memento .receipt-paper__stamp, .receipt-paper__memento .receipt-paper__barcode { margin: 7rpx 0; }
