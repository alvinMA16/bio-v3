.stage {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #d8c5a8;
}

.last-receipt { margin: auto 0 0; padding: 14rpx 26rpx; background: #faf3e3b8; color: #81735d; font-size: 22rpx; line-height: 1.5; border-radius: 8rpx; }
.receipt-printer { position: fixed; z-index: 5; top: 50.1%; bottom: calc(2.3% + env(safe-area-inset-bottom)); left: 6%; right: 6%; display: flex; flex-direction: column; align-items: center; color: #5e5546; }
.receipt-slot { position: absolute; top: 0; z-index: 0; flex-shrink: 0; width: 97%; height: 45rpx; border-radius: 20rpx; background: radial-gradient(ellipse at 40% 0, #fff9e6aa, transparent 65%), #c6b89d; box-shadow: inset 0 3rpx 5rpx #8d7a5d70, inset 0 -3rpx 4rpx #fffae8b0, 0 2rpx 5rpx #fffbee; }
.receipt-slot::before { content: ''; position: absolute; top: 5rpx; right: 7rpx; bottom: 5rpx; left: 7rpx; border: 1rpx dashed #a08f7260; border-radius: 15rpx; }
.receipt-slot__mouth { position: absolute; top: 12rpx; right: 20rpx; bottom: 11rpx; left: 20rpx; border-radius: 8rpx; background: #494033; box-shadow: inset 0 7rpx 8rpx #211a11cc, 0 -2rpx 3rpx #a6977d; }
.receipt-slot__lip { position: absolute; z-index: 3; height: 8rpx; left: 30rpx; right: 30rpx; top: 34rpx; border-radius: 50%; background: #dfd1b8; box-shadow: 0 -2rpx 3rpx #71604766, 0 2rpx 3rpx #fff8e5; }
.receipt-feed { position: relative; z-index: 1; width: 100%; flex: 1; min-height: 0; margin-top: 18rpx; padding: 0 28rpx 24rpx; box-sizing: border-box; overflow: hidden; perspective: 1800rpx; }
.receipt-feed::after { content: ''; position: absolute; top: 0; left: 28rpx; right: 28rpx; height: 24rpx; background: linear-gradient(#48392380, transparent); pointer-events: none; }
.receipt-paper { position: relative; display: flex; flex-direction: column; justify-content: space-evenly; height: 100%; box-sizing: border-box; padding: 20rpx 30rpx; transform-origin: center top; background: linear-gradient(95deg, #e4e4df, #f5f5f2 6%, #f5f5f2 92%, #e7e7e2); box-shadow: 3rpx 8rpx 14rpx #6c573d26, inset 0 -12rpx 15rpx -12rpx #b9b9b2; animation: receipt-physical-feed 4200ms both; }
.receipt-paper::after { content: ''; position: absolute; top: 100%; left: 0; right: 0; height: 18rpx; background: linear-gradient(135deg, #f5f5f2 25%, transparent 25%) -16rpx 0, linear-gradient(225deg, #f5f5f2 25%, transparent 25%) -16rpx 0; background-size: 32rpx 32rpx; filter: drop-shadow(0 4rpx 3rpx #79603a20); }
.receipt-paper__time { margin-top: 4rpx; text-align: center; font: 32rpx/1.5 monospace; }
.receipt-paper__title { text-align: center; font-family: serif; font-size: 52rpx; letter-spacing: 5rpx; line-height: 1.25; margin: 0 0 8rpx; }
.receipt-paper__date { text-align: center; font-family: monospace; font-size: 30rpx; line-height: 1.5; color: #8c806d; }
.receipt-paper__rule { border-top: 2rpx dashed #bdb19a; margin: 12rpx 0; }
.receipt-paper__row { display: flex; justify-content: space-between; margin: 0; padding: 16rpx 0; font-size: 34rpx; line-height: 1.35; }
.receipt-paper__row text:last-child { font-family: monospace; }
.receipt-keep { margin: 0; flex-shrink: 0; border: 0; border-radius: 40rpx; padding: 0 68rpx; line-height: 76rpx; background: #596b60; color: #fafbf7; font-size: 30rpx; letter-spacing: 2rpx; box-shadow: inset 0 2rpx 3rpx #ffffff20, 0 5rpx 10rpx #34463b24; }
.receipt-keep::after { border: 0; }
@keyframes receipt-physical-feed { 0%, 8.33% { transform: translateY(-104%) rotateX(-4deg); } 32.14%, 35.95% { transform: translateY(-76%) rotateX(-3deg); } 64.28%, 68.57% { transform: translateY(-35%) rotateX(-2deg); } 95.23%, 100% { transform: translateY(0) rotateX(-1deg); } }
.receipt-printer--closing { pointer-events: none; animation: receipt-close 360ms ease-in both; }
@keyframes receipt-close { to { opacity: 0; transform: translateY(12rpx); } }
@media (prefers-reduced-motion: reduce) { .receipt-paper, .receipt-printer--closing { animation: none; } }

.stage__layer, .stage__actor { position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; }
.stage__actor { z-index: 1; overflow: hidden; }
.stage__sheet { position: absolute; max-width: none; opacity: 0; pointer-events: none; }
.stage__sheet--active { opacity: 1; }
.stage__panel { z-index: 2; }
/* Generated transparent props placed freely on the felt desktop. */
.desk-home { position: absolute; z-index: 3; top: 51%; right: 44rpx; bottom: calc(38rpx + env(safe-area-inset-bottom)); left: 44rpx; color: #625442; }
.desk-entry { position: absolute; box-sizing: border-box; width: 260rpx; margin: 0; padding: 0 0 12rpx; overflow: visible; border: 0; border-radius: 24rpx; background: transparent; color: inherit; line-height: 1.4; transition: transform 180ms ease; }
.desk-entry--folder { top: 3%; left: 0; }
.desk-entry--call { top: 24%; right: 0; width: 310rpx; }
.desk-entry--manuscripts { bottom: 1%; left: 44rpx; width: 248rpx; }
.desk-entry--pressed { transform: translateY(5rpx) scale(.96); }
.desk-entry__icon { display: block; width: 100%; height: 250rpx; }
.desk-entry--folder .desk-entry__icon { transform: rotate(-9deg); }
.desk-entry--call .desk-entry__icon { height: 296rpx; transform: rotate(5deg); }
.desk-entry--manuscripts .desk-entry__icon { height: 238rpx; transform: rotate(-7deg); }
.desk-entry__name { margin-top: 0; font-size: 28rpx; font-weight: 500; letter-spacing: 3rpx; text-shadow: 0 1rpx 2rpx #fff9ed; }
.desk-entry--call .desk-entry__name { font-weight: 600; }
.last-receipt { position: absolute; right: 8rpx; bottom: 4rpx; }
.drawer-backdrop { position: fixed; z-index: 10; top: 0; right: 0; bottom: 0; left: 0; background: #30291f66; display: flex; align-items: flex-end; }
.drawer { position: relative; box-sizing: border-box; width: 100%; padding: 22rpx 48rpx calc(42rpx + env(safe-area-inset-bottom)); border-radius: 38rpx 38rpx 0 0; background: #f7f2e8; color: #514a3e; box-shadow: 0 -12rpx 60rpx #30291f16; }
.drawer__handle { width: 60rpx; height: 7rpx; margin: 0 auto 36rpx; border-radius: 9rpx; background: #d5caba; }
.drawer__close { position: absolute; right: 24rpx; top: 25rpx; margin: 0; padding: 0; width: 72rpx; height: 72rpx; font-size: 43rpx; line-height: 72rpx; background: transparent; color: #8a8071; }
.drawer__eyebrow { color: #9b8f7b; font-size: 22rpx; letter-spacing: 3rpx; }
.drawer__title { margin-top: 12rpx; font-size: 44rpx; }
.drawer__empty { margin-top: 58rpx; font-size: 30rpx; }
.drawer__description { margin-top: 18rpx; color: #867b6a; font-size: 26rpx; line-height: 1.8; }
.drawer__note { margin-top: 24rpx; color: #a19583; font-size: 22rpx; }
.drawer__action { margin-top: 44rpx; background: #79866b; color: #fff9ed; border-radius: 18rpx; font-size: 28rpx; line-height: 88rpx; }
@media (max-height: 700px) {
  .desk-home { top: 50%; bottom: calc(24rpx + env(safe-area-inset-bottom)); }
  .desk-entry--folder { width: 224rpx; }
  .desk-entry--call { width: 268rpx; top: 22%; }
  .desk-entry--manuscripts { width: 216rpx; bottom: 0; }
  .desk-entry__icon { height: 206rpx; }
  .desk-entry--call .desk-entry__icon { height: 250rpx; }
  .desk-entry--manuscripts .desk-entry__icon { height: 194rpx; }
  .desk-entry__name { font-size: 26rpx; }
}

.receipt-actions { width: 100%; flex-shrink: 0; height: 90rpx; display: flex; align-items: flex-end; justify-content: center; }
