<view class="viewer">
  <button wx:if="{{focused}}" class="focus-back" bindtap="toggleFocus" aria-label="返回对话"><view class="back-chevron" /></button>
  <view class="stage">
    <view wx:if="{{originalStatus}}" class="status"><view>{{originalStatus === 'deleted' ? '原文件已删除' : '原文件不可用'}}</view><view>已有对话仍保留，可以继续聊。查看或核对原文需重新上传。</view></view>
    <view wx:elif="{{loading}}" class="status">正在展开资料…</view>
    <view wx:elif="{{error}}" class="status">{{error}}<button bindtap="load">重试</button></view>
    <image wx:elif="{{image}}" class="sheet" src="{{image}}" mode="aspectFit" bindtap="tap" />
    <scroll-view wx:else class="text" scroll-y bindtap="tap"><text selectable>{{text}}</text></scroll-view>
  </view>
  <view wx:if="{{!originalStatus && count > 1}}" class="pager"><button data-step="-1" bindtap="turn" disabled="{{page === 1 || loading}}">‹</button><text>{{page}} / {{count}}</text><button data-step="1" bindtap="turn" disabled="{{page === count || loading}}">›</button></view>
  <view class="filebar"><text>{{attachment.title}}</text></view>
</view>
