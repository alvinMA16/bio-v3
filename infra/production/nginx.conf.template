server {
    listen 443 ssl;
    server_name app.storyofme.cn;
    ssl_certificate /etc/letsencrypt/live/app.storyofme.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.storyofme.cn/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    __PREVIEW_AUTH__
    root /srv/bio-v3/web/current;
    index index.html;
    client_max_body_size 25m;
    access_log /var/log/nginx/bio-v3.access.log;
    error_log /var/log/nginx/bio-v3.error.log;
    location = /internal { return 308 /internal/; }
    location = /internal/ { try_files /index.html =404; }
    location / { try_files $uri $uri/ /index.html; }
    location /api/ {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Authorization __AUTHORIZATION__;
        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
server {
    listen 80;
    server_name app.storyofme.cn;
    location /.well-known/acme-challenge/ { root /var/www/bio-v3-acme; }
    location / { return 301 https://$host$request_uri; }
}
