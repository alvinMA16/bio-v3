NODE_ENV=development
PORT=3000

MODEL_PROVIDER=gemini

# Gemini native API (server-side only); set MODEL_PROVIDER=gemini to use by default.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.8-flash

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash

# Optional generic OpenAI-compatible provider
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
USD_TO_CNY_RATE=6.7829

# Relative to apps/api when using pnpm dev:api. Local, single-process storage.
AGENT_DATA_DIR=../../.bio-agent
AGENT_TIMEOUT_MS=120000

DATABASE_URL=postgresql://bio:bio@localhost:5432/bio
REDIS_URL=redis://localhost:6379

# Opt-in PostgreSQL memory. Blank keeps the existing local development behavior.
# Start with: docker compose -f infra/docker-compose.yml up -d postgres
MEMORY_DATABASE_URL=
# Local development only; explicit server-owned identity, ignored in production.
MEMORY_DEV_USER_ID=
# Multi-user pilot: JSON mapping opaque ASCII bearer tokens to stable user IDs.
# Example structure: {"a-long-random-token":"user-id"}; do not commit real tokens.
MEMORY_AUTH_TOKENS={}
MEMORY_WORKER_ENABLED=true
MEMORY_RECONNECT_SECONDS=60
# Completed call summaries pinned at call start (0-20).
MEMORY_RECENT_CALL_COUNT=3

ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=

# Realtime voice: ASR -> Agent (including tools) -> TTS. Server-only credentials.
VOLCENGINE_ASR_APP_ID=
VOLCENGINE_ASR_ACCESS_TOKEN=
VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
DOUBAO_TTS_APP_ID=
DOUBAO_TTS_ACCESS_KEY=
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_SPEAKER=zh_female_kefunvsheng_uranus_bigtts
VOICE_ENDPOINT_MS=2500
VOICE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional OpenAI-compatible vision endpoint for photo understanding / scanned PDF OCR.
# Without these, originals are saved and the user can add a description.
MATERIAL_VISION_BASE_URL=
MATERIAL_VISION_API_KEY=
MATERIAL_VISION_MODEL=
