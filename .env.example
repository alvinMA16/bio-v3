NODE_ENV=development
PORT=3000

MODEL_PROVIDER=deepseek

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash

# Optional generic OpenAI-compatible provider
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
USD_TO_CNY_RATE=6.7829

# Relative to apps/api when using pnpm dev:api. Local, single-process storage.
AGENT_DATA_DIR=../../.bio-agent
AGENT_TIMEOUT_MS=120000

DATABASE_URL=postgresql://bio:bio@localhost:5432/bio
REDIS_URL=redis://localhost:6379

ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=

# Realtime voice: ASR -> Agent (including tools) -> TTS. Server-only credentials.
VOLCENGINE_ASR_APP_ID=
VOLCENGINE_ASR_ACCESS_TOKEN=
VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
DOUBAO_TTS_APP_ID=
DOUBAO_TTS_ACCESS_KEY=
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_SPEAKER=zh_female_kefunvsheng_uranus_bigtts
VOICE_ENDPOINT_MS=2500
VOICE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
